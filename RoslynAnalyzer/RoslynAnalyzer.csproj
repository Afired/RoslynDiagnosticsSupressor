<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" />
    </ItemGroup>

    <Target Name="CopyAnalyzerToUnity" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)"
              DestinationFiles="$(MSBuildProjectDirectory)\..\Assets\RoslynAnalyzer.dll" />
    </Target>

</Project>